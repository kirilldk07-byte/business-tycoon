# ---------- game server (backend) ----------
PORT=3040
HOST=0.0.0.0
# Dev tools (add money, end match, ...). NEVER enable in production.
DEV_TOOLS=0
# Where profiles.json / rooms.json are stored (restart recovery)
DATA_DIR=/var/lib/business-tycoon
# Static client served by the same process (optional; Yandex hosts the client in prod)
PUBLIC_DIR=dist/client
# Comma-separated allowed Origin headers for the WebSocket; empty = allow all.
# Yandex Games iframes run on *.games.s3.yandex.net / *.playhop.com / yandex.ru
ALLOWED_ORIGINS=https://yandex.ru,*.games.s3.yandex.net,*.playhop.com,https://playhop.com
ROOM_SNAPSHOT_MS=3000
MAX_ROOMS=2000
MAX_CONN_PER_IP=20

# ---------- client (build time) ----------
# Production WebSocket URL baked into the client bundle
VITE_WS_URL=wss://tycoon.example.com/ws
