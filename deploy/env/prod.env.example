# Copy to ~/.config/business-tycoon/prod.env (chmod 600). No secrets live here — the backend has none;
# player credentials are generated per profile and stored in DATA_DIR (chmod 700).
NODE_ENV=production
# Production listens on loopback only: the public entry is the Cloudflare tunnel.
HOST=127.0.0.1
PORT=3040
# MUST stay 0 in production (dev commands: add money, end match…)
DEV_TOOLS=0
DATA_DIR=/home/kirill/projects/business-tycoon/data
PUBLIC_DIR=/home/kirill/projects/business-tycoon/dist/client
# Comma-separated Origins (exact, or *.suffix). EMPTY = allow all. Fill after Yandex Draft shows the real origin.
ALLOWED_ORIGINS=
MAX_CONN_PER_IP=20
MAX_ROOMS=2000
