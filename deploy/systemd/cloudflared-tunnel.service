# Cloudflare NAMED tunnel for the production backend (user-level unit — no root needed).
# Prerequisite: ~/.cloudflared/config.yml + credentials JSON (see docs/PRODUCTION_DEPLOY.md, step 3).
# Enable only AFTER the domain + tunnel exist:  systemctl --user enable --now cloudflared-tunnel
# Logs: journalctl --user -u cloudflared-tunnel -f
[Unit]
Description=Cloudflare named tunnel → Business Tycoon backend
After=business-tycoon.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
ExecStart=%h/bin/cloudflared --no-autoupdate tunnel --config %h/.cloudflared/config.yml run
Restart=always
RestartSec=5
NoNewPrivileges=true
SyslogIdentifier=cloudflared-tunnel

[Install]
WantedBy=default.target
